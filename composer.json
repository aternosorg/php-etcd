{
  "name": "aternos/etcd",
  "description": "PHP gRPC client for etcd v3",
  "type": "library",
  "require": {
    "php": "^8.4",
    "google/protobuf": "^5.36",
    "grpc/grpc": "^1.42.0",
    "ext-grpc": "*",
    "flexihash/flexihash": "^3.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Neid",
      "email": "matthias@aternos.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "": "grpc/",
      "Aternos\\Etcd\\": "src/"
    }
  },
  "scripts": {
    "generate-grpc": [
      "rm -rf grpc",
      "mkdir grpc",
      "protoc --proto_path=proto --php_out=grpc --grpc_out=grpc --plugin=protoc-gen-grpc=\"$(command -v grpc_php_plugin)\" proto/*.proto"
    ]
  },
  "scripts-descriptions": {
    "generate-grpc": "Regenerate the PHP classes in grpc/ from the .proto files in proto/ (requires protoc and grpc_php_plugin)"
  }
}
