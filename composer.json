{
  "name": "aternos/etcd",
  "description": "PHP gRPC client for etcd v3",
  "type": "library",
  "require": {
    "php": "^8.5",
    "google/protobuf": "^5.36",
    "grpc/grpc": "^1.82",
    "ext-grpc": "*",
    "flexihash/flexihash": "^3.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Neid",
      "email": "matthias@aternos.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "Aternos\\Etcd\\Proto\\": "grpc/",
      "Aternos\\Etcd\\": "src/"
    }
  },
  "scripts": {
    "generate-grpc": [
      "rm -rf .grpc-tmp",
      "mkdir .grpc-tmp",
      "protoc --proto_path=proto --php_out=.grpc-tmp --grpc_out=.grpc-tmp --plugin=protoc-gen-grpc=\"$(command -v grpc_php_plugin)\" proto/*.proto",
      "rm -rf grpc",
      "mv .grpc-tmp/Aternos/Etcd/Proto grpc",
      "rm -rf .grpc-tmp"
    ]
  },
  "scripts-descriptions": {
    "generate-grpc": "Regenerate the PHP classes in grpc/ from the .proto files in proto/ (requires protoc and grpc_php_plugin)"
  }
}
